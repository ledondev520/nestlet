# Private server configuration. Never put secrets in chat, Git or public URLs.
# The user may enter API keys directly in authenticated HTTPS Settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Explicitly opt in only after privacy terms and data authorization are reviewed.
ENABLE_LIVE_AI=false
PORT=4173
HOST=127.0.0.1
# Exact browser origin for HTTPS deployments behind your reverse proxy.
PUBLIC_ORIGIN=
# Generate privately with npm run hash-password; preserve literal $ using single quotes.
NESTLET_OPERATOR_PASSWORD_HASH=''
# Optional administrator login alias; the internal owner identity stays unchanged.
NESTLET_OPERATOR_USERNAME=owner

# Node 24 SQLite. Local data directory is created privately (0700) if absent.
# Existing insecure directories/files are rejected; choose a new private path.
# Docker Compose supplies /data/nestlet.sqlite on its dedicated case_data volume.
NESTLET_DB_PATH=./data/nestlet.sqlite

# Alibaba Cloud DirectMail cn-hangzhou. Reuse the existing approved account privately.
# No credentials or sender are inferred from another application's configuration.
# Require a verified DirectMail sender; keys never enter browser settings or Git.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional, only when using temporary STS credentials.
ALIBABA_CLOUD_SECURITY_TOKEN=
NESTLET_EMAIL_FROM=

# Durable encrypted provider settings need a separately provisioned private wrapping-key file.
# This is a container-visible path, not the wrapping value. Mount read-only outside /data.
NESTLET_PROVIDER_WRAPPING_KEY_FILE=
