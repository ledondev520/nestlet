{
  "$schema": "nestlet-design-tokens/v1",
  "note": "Mirror of tokens.css for JS/React (shadcn) consumption. Colors are hex; shadcn HSL conversion: keep hex and set the CSS vars directly — do not re-derive from a default template.",
  "color": {
    "paper": "#f6f1e6",
    "paperDeep": "#efe8d8",
    "sheet": "#fffdf6",
    "ink": "#252a20",
    "inkSoft": "#575d4a",
    "faint": "#8d9080",
    "faintStrong": "#5f6350",
    "hairline": "#e0d9c4",
    "hairlineStrong": "#cfc6ab",
    "accent": "#b8402a",
    "accentDeep": "#93311e",
    "accentTint": "#f7e9e2",
    "ok": "#4f6b3d",
    "okTint": "#e9f0df",
    "warn": "#8a5a22",
    "warnTint": "#f7edd9",
    "info": "#3d5a6c",
    "infoTint": "#e4ecf0"
  },
  "semantic": {
    "bgCanvas": "paper",
    "bgSurface": "sheet",
    "bgRecessed": "paperDeep",
    "textPrimary": "ink",
    "textSecondary": "inkSoft",
    "textMuted": "faintStrong",
    "borderDefault": "hairline",
    "borderStrong": "hairlineStrong",
    "actionPrimaryBg": "ink",
    "actionPrimaryText": "paper",
    "actionPrimaryHover": "accent",
    "focusRing": "accent",
    "statusSuccess": "ok",
    "statusSuccessBg": "okTint",
    "statusWarning": "warn",
    "statusWarningBg": "warnTint",
    "statusError": "accentDeep",
    "statusErrorBg": "accentTint",
    "bgOverlay": "sheet",
    "scrim": "rgba(37,42,32,.32)",
    "borderOverlay": "hairlineStrong",
    "inputBg": "paper",
    "inputBgFocus": "sheet",
    "inputBorder": "hairlineStrong",
    "inputBorderFocus": "ink",
    "statusInfo": "info",
    "statusInfoBg": "infoTint",
    "statusWaiting": "inkSoft",
    "statusWaitingBg": "paperDeep"
  },
  "font": {
    "display": [
      "Songti SC",
      "STSong",
      "Noto Serif SC",
      "Georgia",
      "Times New Roman",
      "serif"
    ],
    "body": [
      "-apple-system",
      "BlinkMacSystemFont",
      "PingFang SC",
      "Hiragino Sans GB",
      "Segoe UI",
      "Microsoft YaHei",
      "Noto Sans SC",
      "sans-serif"
    ],
    "mono": [
      "ui-monospace",
      "SF Mono",
      "SFMono-Regular",
      "Menlo",
      "Consolas",
      "monospace"
    ]
  },
  "fontSize": {
    "display": 30,
    "title": 19,
    "body": 14,
    "small": 12,
    "micro": 11
  },
  "lineHeight": {
    "display": 1.3,
    "title": 1.35,
    "body": 1.75,
    "small": 1.65
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40
  ],
  "radius": {
    "badge": 4,
    "control": 8,
    "panel": 14,
    "pill": 999,
    "bubbleUser": "20px 20px 4px 20px",
    "composer": 20
  },
  "shadow": {
    "sheet": "0 1px 2px rgba(88,74,43,.05), 0 10px 30px -12px rgba(88,74,43,.18)",
    "overlay": "0 2px 6px rgba(88,74,43,.08), 0 18px 44px -16px rgba(88,74,43,.3)"
  },
  "motion": {
    "ease": "cubic-bezier(.22,.8,.32,1)",
    "fast": 180,
    "base": 220
  },
  "layout": {
    "shellMax": 960,
    "contentMax": 640,
    "breakpointMobile": 760,
    "readingMax": "68ch",
    "composerMaxHeight": "46vh",
    "directoryRowHeight": 44
  }
}